# 环境
.venv/
__pycache__/
*.pyc
.pytest_cache/
# uv.lock ★ 2026-08-17 起**进版本管理**（原来在这里被忽略）。
# 理由：它是"训练输入确定性"的最后一块。prompt / 工具 / 三桶 / SFT / RL 全部
# 已实测逐字节可复现，唯独依赖解析每台机器可能不同 —— 而 transformers 的版本
# 直接决定 attention 走哪条路径（4.5x 才有 packed 检测，旧版会静默跨序列泄漏）。
# ⇒ 冻结训练之前，这个也得钉死。

# 模型与产物（大文件，不进版本管理）
models/
checkpoints/
wandb/
data/rollouts/

# 生成的数据（可由 `syncopate cases generate` 完全重建）
data/batches/
data/rl/
data/sft/
data/external/creatives/
data/external/ingested.json

# 老师的参考包（版权：深圳途明智启科技，不得传播）
reference/

# 临时
tmp/
*.log
.ipynb_checkpoints/

# nsys profile：单个 300MB+，超 GitHub 100MB 硬限，push 会被 pre-receive 拒
logs/nsys/

# 重建时让开的旧缓存备份（75M，只为万一要回滚；不进版本管理）
_audit/v15_r2_prefix/

# ── 中间产物，不进版本管理（2026-08-31 定性）──────────────────────────────
# Hydra 每跑一次就写一份 930 行的完整 config —— 是运行痕迹不是证据
outputs/
# 性能剖析产物（infra 线，单个 9M）与进程痕迹
logs/torchprof/
logs/b4/
logs/chatstack/
*.pid
# 建库的增量断点缓存（内容与 v15_cot_rows.json 重复，只为"重启不从零"）
data/u_route/*_partial.jsonl
# 已结案实验臂的旧数据 / 冒烟试跑的一次性输出
data/v15_r0/*.OLD_INJECTION/
_audit/*_smoke.json
# 判卷器输出（由 run_*.jsonl 一条命令重出，不是证据本体）
logs/u_route/judged_*.jsonl
