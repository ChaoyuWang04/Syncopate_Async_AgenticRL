{"id": "fu_03", "cat": "followup", "conversation_id": "conv_233895d4465b", "turns": [{"run_id": "run_39285363cd77", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "CPM是广告计费方式之一，按千次曝光计费，即每展示千次广告收费一次。", "summary": "CPM 释义", "clarification": "", "tools": [], "proposal": null}, {"run_id": "run_2a4e3dcc4c97", "status": "succeeded", "terminal": "run.succeeded", "behavior": "clarify", "reply": "CPC是按实际点击次数计费的广告方式，用户点击一次广告就计一次费。", "summary": "CPC 释义", "clarification": "", "tools": [], "proposal": null}]}
