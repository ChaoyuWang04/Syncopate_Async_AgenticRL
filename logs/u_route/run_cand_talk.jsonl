{"id": "fu_06", "cat": "followup", "conversation_id": "conv_443551aa2a50", "turns": [{"run_id": "run_8553b890d04a", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "建议您查看平台政策或联系客户成功团队获取更准确的定义。", "summary": "not_applicable", "clarification": "", "tools": [], "proposal": null}, {"run_id": "run_2a72a9208244", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "自动调整用于长期稳定投放；手动优化适合近期数据异常或者需要精准控制的场景。", "summary": "auto_vs_manual", "clarification": "", "tools": [], "proposal": null}]}
{"id": "fu_07", "cat": "followup", "conversation_id": "conv_4fd77110abc7", "turns": [{"run_id": "run_07ce1eacf377", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "CPI 是每千次展示的花费（Cost Per Install），表示你为每安装付出了多少。值高代表素材不够高效。", "summary": "cpi_definition", "clarification": "", "tools": [], "proposal": null}, {"run_id": "run_a7d2ac99f5a6", "status": "succeeded", "terminal": "run.succeeded", "behavior": "tool_call", "reply": "LTV 是每个安装的平均回收周期（Length of Time Before Install），用回收数除以安装数得出。值低表示素材影响留存不足。", "summary": "ltv_definition", "clarification": "", "tools": [], "proposal": null}]}
{"id": "fu_08", "cat": "followup", "conversation_id": "conv_446a1122b0e5", "turns": [{"run_id": "run_3ab588f61381", "status": "succeeded", "terminal": "run.succeeded", "behavior": "tool_call", "reply": "素材疲劳是指长期高曝光导致效果下降的现象。我们有方法检测并调整投放。", "summary": "creative_fatigue", "clarification": "", "tools": [], "proposal": null}, {"run_id": "run_dbae6f3307ab", "status": "succeeded", "terminal": "run.succeeded", "behavior": "tool_call", "reply": "建议降低 VIDEO_002_004 的频次。近期素材疲劳迹象明显。", "summary": "creative_fatigue", "clarification": "", "tools": [], "proposal": null}]}
{"id": "fu_09", "cat": "followup", "conversation_id": "conv_1e35a76c8177", "turns": [{"run_id": "run_9894052d220f", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "自然量指的是近期无明显归因信号的投放，通常在数据未收敛前暂不调整。", "summary": "no_action", "clarification": "", "tools": [], "proposal": null}, {"run_id": "run_17f711fee599", "status": "succeeded", "terminal": "run.succeeded", "behavior": "tool_call", "reply": "可投放，无冲突。", "summary": "no_action", "clarification": "", "tools": [], "proposal": null}]}
{"id": "fu_10", "cat": "followup", "conversation_id": "conv_436295fd7c18", "turns": [{"run_id": "run_e42decf6da3d", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "CTR是点击率，表示用户点击广告的频率，通常以百分比显示。", "summary": "definition", "clarification": "", "tools": [], "proposal": null}, {"run_id": "run_50867e879443", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "CVR通常和CTR一起看，是转化率（转化/曝光）。", "summary": "definition", "clarification": "", "tools": [], "proposal": null}]}
{"id": "fu_11", "cat": "followup", "conversation_id": "conv_bd2decfccc99", "turns": [{"run_id": "run_c5eb314f3565", "status": "succeeded", "terminal": "run.succeeded", "behavior": "answer", "reply": "大盘代表投放整体效果，包含花费、安装量、CPI、ROAS、CTR等指标。", "summary": "detailed", "clarification": "", "tools": [], "proposal": null}, {"run_id": "run_79a99980252e", "status": "succeeded", "terminal": "run.succeeded", "behavior": "tool_call", "reply": "分别看区域：华东/华南/东南亚 看现有人气，华北/北美 因风控未投。", "summary": "geo_breakdown", "clarification": "", "tools": [], "proposal": null}]}
